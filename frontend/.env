# ==========================
# 🌍 CONFIGURAÇÕES GERAIS
# ==========================
PORT=8080
NODE_ENV=production

# URL pública do frontend (onde o site React será hospedado)
URL_FRONTEND=https://site-envisio-production-9820.up.railway.app

# ==========================
# 💾 BASE DE DADOS
# ==========================
# Exemplo: se usares o PostgreSQL da Railway, substitui pela URL que aparece em "Database"
DATABASE_URL=postgresql://postgres:9900@localhost:5432/academia

# ==========================
# 🔑 AUTENTICAÇÃO JWT
# ==========================
JWT_SECRET=segredo_super_secreto_seguro_123

# ==========================
# 📧 CONFIGURAÇÕES DE EMAIL (Postmark)
# ==========================
POSTMARK_SERVER_TOKEN=1a2cb209-d23b-46b7-ac65-e58ea6564e1c
EMAIL_FROM=geral@envisio.co.ao
EMAIL_TO=geral@envisio.co.ao

# ==========================
# 🔗 API DO BACKEND (usada pelo frontend)
# ==========================
# 👉 Esta é a parte mais importante!
# Aqui definimos a base da API para o Axios no frontend.
REACT_APP_API_ACADEMIA=https://site-envisio-production-9820.up.railway.app
